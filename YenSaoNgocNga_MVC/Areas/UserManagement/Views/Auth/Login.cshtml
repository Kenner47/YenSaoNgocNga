@model YenSaoNgocNga_MVC.Areas.UserManagement.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="fas fa-dove text-primary mb-3" style="font-size: 3rem;"></i>
                            <h2 class="h3 mb-3">Đăng Nhập</h2>
                            <p class="text-muted">Chào mừng bạn trở lại!</p>
                        </div>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6>Lỗi validation:</h6>
                                @foreach (var error in ViewData.ModelState)
                                {
                                    <div><strong>@error.Key:</strong></div>
                                    @foreach (var modelError in error.Value.Errors)
                                    {
                                        <div>- @modelError.ErrorMessage</div>
                                    }
                                }
                            </div>
                        }

                        <!-- 🔥 DEBUG BUTTON -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-warning btn-sm" onclick="testApi()">
                                🔥 Test API
                            </button>
                        </div>

                        <form asp-action="Login" method="post" id="loginForm">
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label">
                                    <i class="fas fa-user me-2"></i>Tên đăng nhập
                                </label>
                                <input asp-for="Username" class="form-control form-control-lg"
                                       placeholder="Nhập tên đăng nhập" value="admin" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">
                                    <i class="fas fa-lock me-2"></i>Mật khẩu
                                </label>
                                <input asp-for="Password" type="password"
                                       class="form-control form-control-lg"
                                       placeholder="Nhập mật khẩu" value="admin123" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                <label asp-for="RememberMe" class="form-check-label">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg" id="loginBtn">
                                    <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập
                                </button>
                            </div>

                            <div class="text-center">
                                <a asp-action="Register" class="text-decoration-none">
                                    Chưa có tài khoản? <strong>Đăng ký ngay</strong>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function testApi() {
            console.log('🔥 Testing API...');

            fetch('/UserManagement/Auth/TestLogin?username=admin&password=admin123', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                }
            })
            .then(response => response.json())
            .then(data => {
                console.log('🔥 API Test Result:', data);
                alert('API Test: ' + JSON.stringify(data, null, 2));
            })
            .catch(error => {
                console.error('🔥 API Test Error:', error);
                alert('API Test Error: ' + error);
            });
        }

        // Log form data before submit
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            console.log('🔥 Form submitting...');
            console.log('🔥 Username:', document.querySelector('input[name="Username"]').value);
            console.log('🔥 Password:', document.querySelector('input[name="Password"]').value);
            console.log('🔥 RememberMe:', document.querySelector('input[name="RememberMe"]').checked);
        });
    </script>
}