<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yến Sào Ngọc Nga</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/YenSaoNgocNga_MVC.styles.css" asp-append-version="true" />
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light fixed-top custom-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-dove me-2 text-primary"></i>
                    <span class="brand-text">Yến Sào Ngọc Nga</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#products">
                                <i class="fas fa-leaf me-1"></i> Sản Phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#about">
                                <i class="fas fa-info-circle me-1"></i> Giới Thiệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact">
                                <i class="fas fa-phone me-1"></i> Liên Hệ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-primary ms-2 px-3" href="#login">
                                <i class="fas fa-user me-1"></i> Đăng Nhập
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="custom-footer bg-dark text-light">
        <div class="container py-3">
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <h5 class="mb-2">
                        <i class="fas fa-dove me-2"></i>
                        Yến Sào Ngọc Nga
                    </h5>
                    <p class="text-muted small">Chuyên cung cấp yến sào cao cấp, tự nhiên 100% từ những vùng nguyên liệu tốt nhất Việt Nam.</p>
                    <div class="social-links">
                        <a href="#" class="me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-youtube"></i></a>
                        <a href="#"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-3">
                    <h6 class="mb-2">Sản Phẩm</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-muted">Yến Thô</a></li>
                        <li><a href="#" class="text-muted">Yến Chưng</a></li>
                        <li><a href="#" class="text-muted">Yến Tinh Chế</a></li>
                        <li><a href="#" class="text-muted">Phụ Kiện</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-3">
                    <h6 class="mb-2">Liên Hệ</h6>
                    <ul class="list-unstyled text-muted small">
                        <li><i class="fas fa-map-marker-alt me-2"></i> TP.HCM, Việt Nam</li>
                        <li><i class="fas fa-phone me-2"></i> 0123 456 789</li>
                        <li><i class="fas fa-envelope me-2"></i> info@yensaongocnga.vn</li>
                    </ul>
                </div>
                <div class="col-lg-3 mb-3">
                    <h6 class="mb-2">Đăng Ký Nhận Tin</h6>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Email của bạn">
                        <button class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            <hr class="my-2">
            <div class="text-center">
                <p class="mb-0 small">&copy; 2025 Yến Sào Ngọc Nga. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>